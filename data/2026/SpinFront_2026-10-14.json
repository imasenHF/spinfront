      "report_date": "2026-10-14",
      "item_no": 3,
      "title_cn": "选择性脯氨酸标记把134 kDa蛋白的局部位点带入MAS NMR",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solid_state_nmr"
      ],
      "method_ids": [
        "mas",
        "multinuclear_nmr"
      ],
      "application_ids": [
