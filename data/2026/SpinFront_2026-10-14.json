      "report_date": "2026-10-14",
      "item_no": 4,
      "title_cn": "锂枝晶形貌与铜界面共同改变内源DNP响应",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solid_state_nmr"
      ],
      "method_ids": [
        "dnp",
        "polarization_transfer"
      ],
      "application_ids": [
