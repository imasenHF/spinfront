    {
      "item_id": "SF-20261122-03",
      "report_date": "2026-11-22",
      "item_no": 3,
      "title_cn": "异核标量耦合符号识别顺式非脯氨酸肽键",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solution_nmr"],
      "method_ids": ["multidimensional_nmr"],
      "application_ids": ["structural_biology"],
      "sample_systems": [],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Balamurughan 等以富二硫键肽为模型，系统比较异核标量耦合和化学位移；E-COSY型实验显示，两键²J(HN,C′)耦合的符号在顺式非脯氨酸肽键中相对反式构象发生反转，并得到DFT计算支持。",
      "meaning_cn": "耦合符号提供了比单纯化学位移更直接的顺式/反式判据，可用于溶液NMR中罕见顺式非脯氨酸肽键的构象归属。验证集中于富二硫键肽，推广到更大蛋白或谱峰重叠体系时仍需确认E-COSY交叉峰质量和耦合符号可辨性。",
      "publication_date": "2026-11-19",
      "time_scope": "7d_extension",
      "source": "Protein Science",
      "url": "https://doi.org/10.1002/pro.70885",
      "doi": "10.1002/pro.70885",
      "alternative_sources": [{"name": "PubMed题录", "url": "https://pubmed.ncbi.nlm.nih.gov/43059063/"}],
      "related_to": [],
