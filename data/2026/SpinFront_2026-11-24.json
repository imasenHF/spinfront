    {
      "item_id": "SF-20261124-02",
      "report_date": "2026-11-24",
      "item_no": 2,
      "title_cn": "多尺度模拟将四极核固体 NMR 谱推进到毫秒时间尺度",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solid_state_nmr"
      ],
      "method_ids": [
        "computation_nmr"
      ],
      "application_ids": [
        "battery"
      ],
      "sample_systems": [
        "尖晶石 Li₄Ti₅O₁₂"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Huss 等将机器学习预测的电场梯度与分子动力学、动力学蒙特卡洛结合，用于模拟四极核固体 NMR 谱。在尖晶石钛酸锂模型中，计算覆盖数千原子和毫秒时间尺度，可比较静态到快扩散各区间的谱形，并与实验谱获得定性一致。",
      "meaning_cn": "将局部结构无序与离子跃迁放到同一模型中，有助于辨别谱形改变是由位点分布还是运动平均引起的。钛酸锂仅验证了定性谱形；比较其他电极材料的离子迁移速率时，还需验证电场梯度模型与跃迁参数。",
      "publication_date": "2026-11-23",
      "time_scope": "7d_extension",
      "source": "The Journal of Physical Chemistry Letters",
      "url": "https://doi.org/10.1021/acs.jpclett.6c02663",
      "doi": "10.1021/acs.jpclett.6c02663",
      "alternative_sources": [],
      "related_to": [],
      "review_status": "approved",
      "tag_review_status": "approved",
      "publication_status": "early_access",
      "first_seen": "2026-11-24",
      "last_updated": "2026-11-24",
      "report_file": "SpinFront_2026-11-24.html"
    },
    {
      "item_id": "SF-20261124-03",
      "report_date": "2026-11-24",
      "item_no": 3,
      "title_cn": "ShiftML4 降低分子晶体 ¹³C 和 ¹⁵N 化学位移预测误差",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solid_state_nmr"
      ],
      "method_ids": [
        "computation_nmr"
      ],
      "application_ids": [
        "chemical_structure"
      ],
      "sample_systems": [
        "有机分子晶体"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Kellner 等用近似 PBE0 的单分子修正计算训练 ShiftML4，预测有机分子固体中的化学屏蔽张量。实验基准使用相同几何结构时，¹³C 各向同性位移预测误差较 ShiftML3 和 GIPAW-PBE 均下降约三成，¹⁵N 较 ShiftML3 下降约 15%，¹H 则基本不变。",
      "meaning_cn": "结构筛选时可优先用改进的 ¹³C 和 ¹⁵N 位移预测区分候选堆积。将模型与机器学习势生成的晶体几何结合后，基准误差分别为 1.5 和 3.7 ppm；这些数值依赖基准样品及几何优化流程，不能直接作为未知样品的归属容差。",
      "publication_date": "2026-11-23",
      "time_scope": "7d_extension",
      "source": "The Journal of Physical Chemistry Letters",
      "url": "https://doi.org/10.1021/acs.jpclett.6c02955",
      "doi": "10.1021/acs.jpclett.6c02955",
      "alternative_sources": [],
      "related_to": [],
      "review_status": "approved",
      "tag_review_status": "approved",
      "publication_status": "early_access",
      "first_seen": "2026-11-24",
      "last_updated": "2026-11-24",
      "report_file": "SpinFront_2026-11-24.html"
    },
