      "item_no": 3,
      "title_cn": "高频EPR与微SQUID解析分子环形磁矩稳定性",
      "direction_ids": [
        "epr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "inorganic_coordination"
      ],
