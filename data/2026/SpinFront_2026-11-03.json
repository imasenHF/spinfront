    {
      "item_id": "SF-20261103-03",
      "report_date": "2026-11-03",
      "item_no": 3,
      "title_cn": "微型FID探针扩大小孔径磁体测场范围",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "instrumentation"
      ],
      "sample_systems": [
        "7 T小孔径磁体",
        "液体NMR测场样品"
      ],
      "instrument_component_ids": [
        "probe"
      ],
      "information_type": "paper",
      "summary_cn": "Zhou 等集成螺线管微线圈、调谐匹配网络与液体样品单元，构建最大宽度约8 mm的FID核磁测场探针。在7 T轴向对比中，平均绝对偏差为0.27 μT；用于172 mm孔径磁体的近壁测量时，可达轨迹直径从152增至164 mm，扩展了边界测场空间。",
      "meaning_cn": "探针缩小的是机械占用，测量仍依赖可读FID与合适的调谐匹配。15—35 ℃重复测量标准差为0.019—0.046 ppm，不能当作全场绝对准确度；轨迹直径提升7.9%也不等于成像视野扩大7.9%，磁场均匀性和边界空间需分别验收。",
      "publication_date": "2026-11-02",
      "time_scope": "7d_extension",
      "source": "Review of Scientific Instruments",
      "url": "https://doi.org/10.1063/5.0352403",
      "doi": "10.1063/5.0352403",
      "alternative_sources": [
        {
          "name": "Crossref作者、日期与题录",
