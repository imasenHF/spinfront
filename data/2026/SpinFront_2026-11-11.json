    {
      "item_id": "SF-20261111-03",
      "report_date": "2026-11-11",
      "item_no": 3,
      "title_cn": "³¹P NMR 区分不同土壤中的历史累积磷",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solution_nmr"
      ],
      "method_ids": [],
