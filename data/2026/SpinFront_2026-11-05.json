    {
      "item_id": "SF-20261105-02",
      "report_date": "2026-11-05",
      "item_no": 2,
      "title_cn": "相关随机磁场产生非洛伦兹自旋弛豫谱",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [],
      "sample_systems": [
        "轴向相关随机磁场",
        "理论自旋体系"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Field 扩展基于随机微分方程的自旋弛豫理论，将驱动随机磁场的时间相关性纳入极端窄化近似之外。对于轴向磁场涨落，研究得到非微扰的精确动力学解；有限场参数对应非洛伦兹谱，并提出谱矩分析和参数提取方法，极端窄化极限下恢复洛伦兹线形。",
      "meaning_cn": "该理论提醒线宽、谱矩得到的可观测时间尺度不必等同于单指数特征弛豫时间。比较相关场涨落模型时，应同时检查时间域和频域的一致性；精确解针对轴向涨落条件，不能不加验证地套用于任意多轴随机场或复杂耦合自旋样品。",
      "publication_date": "2026-11-04",
      "time_scope": "7d_extension",
      "source": "Royal Society Open Science",
