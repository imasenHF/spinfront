    {
      "item_id": "SF-20261119-04",
      "report_date": "2026-11-19",
      "item_no": 4,
      "title_cn": "合成 MRS 数据综述覆盖基线、场不均匀和采样误差建模",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
