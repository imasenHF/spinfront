      "report_date": "2026-11-06",
      "item_no": 1,
      "title_cn": "场循环NMR弛豫区分胰岛素聚集与模型蛋白糖化",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
