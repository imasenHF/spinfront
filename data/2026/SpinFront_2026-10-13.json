    {
      "item_id": "SF-20261013-03",
      "report_date": "2026-10-13",
      "item_no": 3,
      "title_cn": "变温NMR热重熔反演CO₂驱替中的重组分沉积",
      "direction_ids": ["nmr"],
      "experiment_type_ids": [],
      "method_ids": ["reaction_monitoring"],
      "application_ids": ["geoscience_flow", "process_analysis"],
      "sample_systems": ["致密储层岩心", "CO₂驱替蜡与沥青质沉积"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Gong等利用重组分受热后由固态转为液态并恢复NMR可见性的特征，以热重熔前后信号差定量定位岩心内蜡和沥青质沉积。方法先建立温度—信号校正，再构造温度—浓度联合模型；NMR反演量与物料衡算值的相对误差为2.40%。",
      "meaning_cn": "该方法测量常温下NMR不可见的固态沉积，适合把总沉积量分解到岩心空间位置。复现实验需校准升温引起的信号衰减、样品热平衡时间和氢指数，并以物料衡算检查反演偏差；局部组成比对单位质量氢指数影响较小的结论限于文中校准范围。",
      "publication_date": "2026-10-12",
      "time_scope": "24h",
      "source": "SPE Asia Pacific Oil & Gas Conference and Exhibition",
      "url": "https://doi.org/10.2118/234599-MS",
