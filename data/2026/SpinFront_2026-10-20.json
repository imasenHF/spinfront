    {
      "item_id": "SF-20261020-03",
      "report_date": "2026-10-20",
      "item_no": 3,
      "title_cn": "³¹P滴定区分焦磷酸与亚氨基二磷酸的质子化物种",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solution_nmr"
      ],
      "method_ids": [],
      "application_ids": [
        "inorganic_coordination"
      ],
      "sample_systems": [
        "焦磷酸根",
        "亚氨基二磷酸根",
        "水溶液磷氧与磷氮配体"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Maki 等结合电位滴定、pH依赖³¹P NMR位移及非线性最小二乘分析，求得焦磷酸根与亚氨基二磷酸根逐级质子化常数和各物种本征位移。亚氨基桥提高碱性；跨短链与环状类似物比较显示，端位或内部磷酸基的位置及相邻桥原子主导位移，每个相邻亚氨基氮约带来10 ppm低场移动。",
      "meaning_cn": "³¹P位移随pH变化同时反映物种比例与本征电子环境，不能把混合物观测位移直接当作单一结构的指纹。该分析把逐级质子化与桥连原子的贡献分开，但互变异构及远端桥原子仍会影响位移，配位体系的解释需保留这些修正因素。",
      "publication_date": "2026-10-19",
      "time_scope": "7d_extension",
      "source": "Bulletin of the Chemical Society of Japan",
      "url": "https://academic.oup.com/bcsj/advance-article/doi/10.1093/bulcsj/uoag142/8943740",
      "doi": "10.1093/bulcsj/uoag142",
