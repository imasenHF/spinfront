      "report_file": "SpinFront_2026-11-25.html"
    },
    {
      "item_id": "SF-20261125-03",
      "report_date": "2026-11-25",
      "item_no": 3,
      "title_cn": "3 T 活体波谱用 PRESS 回波时序减弱谷氨酸拟合相关",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "in_vivo_mrs"
      ],
      "method_ids": [
        "spectral_processing"
      ],
      "application_ids": [
        "life_science"
      ],
      "sample_systems": [
        "前扣带回",
        "谷氨酸",
        "脑代谢物"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Hong 等用蒙特卡洛模拟和谱拟合模型联合优化 3 T PRESS 的首段与总回波时间，再用前扣带回活体波谱验证。谱线宽为 6 Hz 时，最佳时间组合为 40 ms 和 95 ms；按线宽选取回波时间后，谷氨酸的总体谱相关系数低于 0.05。",
      "meaning_cn": "若拟用 3 T 波谱做谷氨酸与其他脑代谢物的相关分析，可先量实测线宽，再选择对应的 PRESS 时序；4–10 Hz 的最优组合不同。该优化降低的是重叠引起的拟合相关，不等于脑内代谢物之间不存在生理关联。",
      "publication_date": "2026-11-23",
      "time_scope": "7d_extension",
      "source": "Magnetic Resonance in Medicine",
      "url": "https://doi.org/10.1002/mrm.70659",
      "doi": "10.1002/mrm.70659",
      "alternative_sources": [],
      "related_to": [],
