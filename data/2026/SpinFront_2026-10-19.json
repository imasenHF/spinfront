    {
      "item_id": "SF-20261019-04",
      "report_date": "2026-10-19",
      "item_no": 4,
      "title_cn": "钻孔NMR渗透系数模型需要场地校准，不能照搬油藏常数",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "geoscience_flow"
      ],
      "sample_systems": [
        "英国Sherwood砂岩群",
        "三口钻孔地下水含水层"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Oguntade 等在三口Sherwood砂岩钻孔中比较NMR测井与抽水试验，发现直接采用油藏经验常数的SDR和Timur–Coates模型会将渗透系数低估至少两个数量级。将测井结果上尺度化，并以半约束最小二乘重新标定场地参数后，两类估计与抽水结果的差距缩至一个数量级以内。",
      "meaning_cn": "NMR测井的含水孔隙度与孔隙几何信息对应较高垂向分辨率，而抽水试验代表更大的采样体积，模型校准前应先统一比较尺度。这里的改善来自特定砂岩群及三口井的现场参数，并非证明油藏模型可直接迁移到任意浅层含水层，也不能将误差范围写成精确预测。",
      "publication_date": "2026-10-17",
      "time_scope": "7d_extension",
      "source": "Hydrogeology Journal",
      "url": "https://link.springer.com/article/10.1007/s10040-026-03192-2",
      "doi": "10.1007/s10040-026-03192-2",
      "alternative_sources": [],
      "related_to": [],
      "review_status": "unreviewed",
      "tag_review_status": "approved",
      "publication_status": "published",
      "first_seen": "2026-10-19",
      "last_updated": "2026-10-19",
      "report_file": "SpinFront_2026-10-19.html"
    },
    {
