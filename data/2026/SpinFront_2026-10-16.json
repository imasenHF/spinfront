      ],
      "sample_systems": [
        "Leu-d₄-Cβ-d₂",
        "MBP",
        "真核表达蛋白"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Schindler 等将亮氨酸侧链局部氘代扩展到β位，保留立体选择性¹³CH₃标记，用于真核表达蛋白的甲基NMR。MBP对照的¹H、¹³C-HMQC图注报告，两核平均线宽比约为0.86和0.83；研究针对难以在细菌中正确表达、又难以整体氘代的大蛋白提出样品标记方案。",
      "meaning_cn": "标记设计针对甲基周围的局部质子环境。0.86和0.83来自所列MBP对照，不能直接作为所有真核蛋白的预期线宽比。实际采用时需检查标记掺入、甲基峰数与同批对照谱；样品表达体系和整体氘代背景均会影响结果。",
      "publication_date": "2026-10-12",
      "time_scope": "7d_extension",
      "source": "Chemical Communications",
      "url": "https://pubs.rsc.org/cc/article/doi/10.1039/d6cc04840d/1368285/Extended-local-deuteration-of-leucine-enhances",
