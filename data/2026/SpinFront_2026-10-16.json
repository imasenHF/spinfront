    {
      "item_id": "SF-20261016-02",
      "report_date": "2026-10-16",
      "item_no": 2,
      "title_cn": "亮氨酸β位局部氘代减少大蛋白甲基NMR线宽",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solution_nmr"
      ],
      "method_ids": [
        "multidimensional_nmr"
      ],
