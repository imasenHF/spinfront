    {
      "item_id": "SF-20261111-02",
      "report_date": "2026-11-11",
      "item_no": 2,
      "title_cn": "原位 EPR 追踪多孔液体中的变压气体交换",
      "direction_ids": [
        "epr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "spin_probe"
      ],
      "application_ids": [
        "materials"
