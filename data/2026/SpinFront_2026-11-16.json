    {
      "item_id": "SF-20261116-02",
      "report_date": "2026-11-16",
      "item_no": 2,
      "title_cn": "NMR 区分 CECR2 对组蛋白与 RelA 的结合模式",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "structural_biology"
      ],
      "instrument_component_ids": [],
      "sample_systems": [
        "CECR2溴结构域",
        "乙酰化组蛋白",
        "RelA"
      ],
      "information_type": "paper",
      "summary_cn": "Phillips 等结合 NMR、量热和结合实验比较 CECR2 溴结构域对乙酰化组蛋白及非组蛋白 RelA 的识别。RelA 与组蛋白配体占据同一保守口袋，却产生不同的残基扰动图；所测核小体的结合则要求组蛋白具有多处乙酰化。",
      "meaning_cn": "残基扰动图可以检验共用口袋的配体是否引发同样的局部响应；配合量热，可把谱学位置线索和亲和力测量分开解释。肽段与完整核小体的结构环境不同，不能把短肽上的单个位点结果直接外推到染色质结合。",
      "publication_date": "2026-11-13",
      "time_scope": "7d_extension",
      "source": "Journal of Molecular Biology",
      "url": "https://doi.org/10.1016/j.jmb.2026.170094",
      "doi": "10.1016/j.jmb.2026.170094",
      "alternative_sources": [
        {
          "name": "PubMed 题录与摘要",
          "url": "https://pubmed.ncbi.nlm.nih.gov/43025627/"
        }
      ],
