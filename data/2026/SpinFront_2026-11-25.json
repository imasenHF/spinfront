      "item_no": 1,
      "title_cn": "³⁵Cl 四极共振联用固体 NMR 区分药物晶体中的氯位点",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solid_state_nmr"
      ],
      "method_ids": [],
      "application_ids": [
        "pharma"
