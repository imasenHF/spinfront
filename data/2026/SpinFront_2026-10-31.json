    {
      "item_id": "SF-20261031-04",
      "report_date": "2026-10-31",
      "item_no": 4,
      "title_cn": "弛豫理论解释脂肪链中的长寿命核自旋模式",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "computation_nmr"
      ],
      "application_ids": [],
