      "item_no": 2,
      "title_cn": "天然丰度 ¹³C 零场 NMR 实现亚赫兹分子指纹",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solution_nmr"],
      "method_ids": ["zero_field_nmr", "computation_nmr"],
      "application_ids": ["chemical_structure", "instrumentation"],
