    {
      "item_id": "SF-20261119-03",
      "report_date": "2026-11-19",
      "item_no": 3,
      "title_cn": "NMR 弛豫特征结合机器学习预测地热储层渗透率",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "td_nmr"
      ],
      "method_ids": [
        "relaxometry"
      ],
      "application_ids": [
        "geoscience_flow"
      ],
      "instrument_component_ids": [],
      "sample_systems": [],
      "information_type": "paper",
      "summary_cn": "Yadav 等将 NMR 实验数据与机器学习结合，对204块地热岩心建立渗透率预测模型。输入包含有效孔隙度、总孔隙度、有效应力、盐度以及 T₂lm、T₂mode；随机森林在独立测试集上取得 R²=0.968、RMSE=52.414、AARE=62.046%。",
      "meaning_cn": "T₂lm 和 T₂mode 在模型中作为弛豫特征，与孔隙度、应力和盐度共同描述地热条件。结果来自204块岩心及既定测试划分，模型性能受岩性、温度和盐度范围限制；不能直接把 R² 作为跨储层通用精度。",
      "publication_date": "2026-11-17",
      "time_scope": "7d_extension",
      "source": "Geothermal Energy",
      "url": "https://doi.org/10.1186/s40517-026-00420-6",
      "doi": "10.1186/s40517-026-00420-6",
      "alternative_sources": [
        {
          "name": "原文",
          "url": "https://link.springer.com/article/10.1186/s40517-026-00420-6"
        }
      ],
