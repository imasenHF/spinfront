      "item_id": "SF-20261020-01",
      "report_date": "2026-10-20",
      "item_no": 1,
      "title_cn": "负时间信息重建让二维J谱与纯位移¹H谱更清晰",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solution_nmr"
      ],
      "method_ids": [
        "pure_shift",
        "multidimensional_nmr",
