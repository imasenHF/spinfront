    {
      "item_id": "SF-20261122-06",
      "report_date": "2026-11-22",
      "item_no": 6,
      "title_cn": "BONCAT 快速筛选原位膜蛋白 NMR 同位素标记方案",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solid_state_nmr"],
      "method_ids": [],
      "application_ids": ["structural_biology", "microbiome"],
      "sample_systems": ["完整细菌与原生外膜囊泡"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Wood 等以BONCAT代谢掺入含叠氮基的非天然氨基酸，再经CuAAC连接荧光染料；SDS-PAGE荧光可先筛查内源蛋白背景，从而快速优化完整细胞和原生外膜囊泡中的目标膜蛋白同位素标记，获得背景可忽略的高分辨原位NMR谱。",
      "meaning_cn": "该流程把耗时的NMR试错前移到荧光筛选，可减少昂贵同位素培养与谱仪时间，并兼容外膜表面的荧光或纳米金标记。它仍依赖目标蛋白表达、非天然氨基酸掺入效率和背景抑制；结果为预印本，正式同行评议前需审慎使用。",
      "publication_date": "2026-11-17",
      "time_scope": "7d_extension",
      "source": "bioRxiv",
      "url": "https://doi.org/10.64898/2026.11.14.766694",
      "doi": "10.64898/2026.11.14.766694",
      "alternative_sources": [{"name": "bioRxiv题录与摘要", "url": "https://biorxiv.science/record/biorxiv%3A10.64898%2F2026.11.14.766694/rapid-screening-of-target-specific-isotope-labeling-protocols-for-in-situ-nmr-of-bacterial-membrane"}],
