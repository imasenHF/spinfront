      "report_date": "2026-11-25",
      "item_no": 8,
      "title_cn": "NMR 交叉弛豫揭示维生素 D₃ 在模型膜中的定位",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solution_nmr"
      ],
      "method_ids": [
        "computation_nmr"
      ],
      "application_ids": [
        "life_science"
      ],
      "sample_systems": [
        "维生素 D₃",
        "羟丙基-β-环糊精",
        "DMPC 模型膜"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Selyutina 等用交叉弛豫率约束分子动力学模型，发现维生素 D₃ 主要位于 DMPC 模型膜的界面，特定烯烃质子靠近甘油骨架与脂链上段。羟丙基-β-环糊精形成的 1:2 包合体遮蔽维生素的疏水骨架，在高浓度下不易通过直接接触向膜快速转移。",
      "meaning_cn": "交叉弛豫与模拟联用可区分“在膜界面附近”与“已插入脂链内部”。结果支持稀释后包合体先解离的解释，适用范围受模型膜组成和主客体浓度限制，不能直接据此推断真实细胞膜上的转运速率。",
      "publication_date": "2026-11-24",
      "time_scope": "7d_extension",
      "source": "Langmuir",
      "url": "https://doi.org/10.1021/acs.langmuir.6c06062",
      "doi": "10.1021/acs.langmuir.6c06062",
