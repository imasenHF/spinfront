    {
      "item_id": "SF-20261119-06",
      "report_date": "2026-11-19",
      "item_no": 6,
      "title_cn": "高频 ESR 解析近化学计量 Fe₃GeTe₂ 的磁各向异性与磁振子隙",
      "direction_ids": [
        "epr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "materials"
      ],
      "instrument_component_ids": [],
      "sample_systems": [],
      "information_type": "paper",
      "summary_cn": "Pal 等对近化学计量 Fe₃.₀₃GeTe₂ 单晶开展宽频率、变温和变场 ESR。频率依赖结果显示易轴铁磁行为；3 K 时内禀单轴磁晶各向异性能量约为−5×10⁶ erg cm⁻³，磁振子隙为87.8±13.7 GHz（0.363±0.057 meV），且 ESR 线位移在居里温度以上仍存在。",
      "meaning_cn": "宽频 ESR 将共振场与频率、温度和晶轴方向同时比较，可把总各向异性场分解为内禀和形状贡献。样品成分为 Fe₃.₀₃±₀.₀₃Ge₀.₈₉±₀.₀₄Te₂.₀₀±₀.₀₁，结论对 Fe 含量敏感；文中也指出宽线使本征阻尼参数无法可靠定量。",
      "publication_date": "2026-11-17",
      "time_scope": "7d_extension",
      "source": "Physical Review B",
