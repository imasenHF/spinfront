    {
      "item_id": "SF-20261016-01",
      "report_date": "2026-10-16",
      "item_no": 1,
      "title_cn": "2D Q-BEST以三组相关谱定量蛋白浓度与构象布居",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solution_nmr"
      ],
      "method_ids": [
        "qnmr",
        "multidimensional_nmr"
      ],
      "application_ids": [
        "structural_biology"
      ],
      "sample_systems": [
        "泛素",
        "蛋白构象异质性"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Ouali 等提出2D Q-BEST，从三组¹H–¹⁵N相关谱计算蛋白浓度及相对状态布居。泛素模型中，单个交叉峰的精度约为15%–20%；对属于同一状态且分辨良好的峰作校正强度平均，可减小统计误差。方法进一步用于多样品浓度比较及内源性、配体诱导的构象异质性分析。",
      "meaning_cn": "该方法直接量化NMR可见蛋白组分，适合比较同一蛋白不同状态的比例。单峰15%–20%的精度不能视为最终浓度误差；平均前需确认峰归属与分辨情况，并保留校正步骤。因聚集、交换或快速弛豫而不可见的组分，仍需其他质量平衡测量。",
      "publication_date": "2026-10-14",
      "time_scope": "7d_extension",
      "source": "Journal of Biomolecular NMR",
      "url": "https://link.springer.com/article/10.1007/s10858-026-00498-x",
      "doi": "10.1007/s10858-026-00498-x",
