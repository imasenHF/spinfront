      "report_date": "2026-11-06",
      "item_no": 4,
      "title_cn": "ORCO按位移歧义调整固体NMR残基候选数",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solid_state_nmr"
      ],
      "method_ids": [
        "spectral_processing"
