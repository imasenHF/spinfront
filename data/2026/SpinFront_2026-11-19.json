    {
      "item_id": "SF-20261119-02",
      "report_date": "2026-11-19",
      "item_no": 2,
      "title_cn": "台式 NMR 综述食品掺假与真实性检测应用",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "benchtop_nmr"
      ],
      "method_ids": [],
