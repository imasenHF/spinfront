      "item_no": 2,
      "title_cn": "CORD-NMR 用跨馏分峰分组辅助天然产物去重复鉴定",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "spectral_processing",
        "computation_nmr"
      ],
