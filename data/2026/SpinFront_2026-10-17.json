      ],
      "application_ids": [
        "structural_biology"
      ],
      "sample_systems": [
        "jR2R3-P301L tau片段",
        "tau纤维种子"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Han等用实时¹H–¹⁵N SOFAST-HMQC追踪tau片段向纤维种子的结合，并以DOSY、ODNP水合测量和CW-EPR线形分析区分组装阶段。结果指向300/301位附近的局部水合热点：初始固定后，其他残基依次进入纤维；在热点引入自旋标签会抑制模板聚集并形成较短纤维。",
      "meaning_cn": "SOFAST-HMQC提供残基级信号消失动力学，ODNP与EPR分别补充界面水运动及标签局部运动信息。NMR峰消失还受分子转动和纤维增长影响，不能直接等同锁定速率；自旋标记位点也须先确认可耐受半胱氨酸替换，结论目前针对所用tau片段。",
      "publication_date": "2026-10-12",
      "time_scope": "7d_extension",
      "source": "PNAS",
      "url": "https://www.pnas.org/doi/10.1073/pnas.2611158123",
