    {
      "item_id": "SF-20261009-02",
      "report_date": "2026-10-09",
      "item_no": 2,
      "title_cn": "qNMR–FRET分开计量脂质体组成与完整囊泡转运",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solution_nmr"],
      "method_ids": ["qnmr"],
      "application_ids": ["life_science"],
      "sample_systems": ["磷脂酰胆碱/胆固醇脂质体", "含磷脂酰甘油或磷脂酰丝氨酸的阴离子脂质体"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Peters等把校准型¹H qNMR与FRET组合：前者分别定量脂质组分，后者识别跨膜转运时仍保持完整的囊泡。磷脂酰胆碱–胆固醇体系出现失稳、组分损失和有限转运；加入磷脂酰甘油或磷脂酰丝氨酸后，结构完整性及以囊泡形式转运的比例增加。",
      "meaning_cn": "¹H qNMR给出化学选择性的总脂质量，单独使用时难以区分游离脂质与完整囊泡；FRET补充了聚集状态信息。复现实验需分别校准回收率、回收延迟、积分线性、染料掺入比例和自猝灭，并设置泄漏、融合及膜吸附对照。",
      "publication_date": "2026-10-08",
      "time_scope": "24h",
      "source": "Analytical Chemistry",
      "url": "https://pubs.acs.org/doi/10.1021/acs.analchem.6c01874",
      "doi": "10.1021/acs.analchem.6c01874",
      "alternative_sources": [],
