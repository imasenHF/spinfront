      "report_date": "2026-11-19",
      "item_no": 1,
      "title_cn": "高维固体 NMR 用优化相干转移脉冲缩短蛋白实验时间",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
