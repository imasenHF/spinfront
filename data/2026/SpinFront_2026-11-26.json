      "report_date": "2026-11-26",
      "item_no": 1,
      "title_cn": "9.4 T 溶液 Overhauser DNP 将 ⁷⁷Se 信号增强两到三个数量级",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solution_nmr"
      ],
      "method_ids": [
        "dnp",
        "multinuclear_nmr",
