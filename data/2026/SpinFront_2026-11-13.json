      "report_file": "SpinFront_2026-11-13.html"
    },
    {
      "item_id": "SF-20261113-02",
      "report_date": "2026-11-13",
      "item_no": 2,
      "title_cn": "时域 NMR 区分原油的析蜡起点与后续结晶",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "td_nmr"
      ],
      "method_ids": [
        "cpmg",
        "relaxometry"
      ],
      "application_ids": [
        "process_analysis"
      ],
      "instrument_component_ids": [],
      "sample_systems": [
        "模型油",
        "巴西原油",
        "蜡晶"
      ],
      "information_type": "paper",
      "summary_cn": "Pereira 等用时域 NMR 和微量量热比较模型油与四种巴西原油。降温时，模型油主要表现为可见信号减少，原油则出现额外的短 T₂ 成分。四种原油的 NMR 析蜡起点为37、49、51和47 °C；4 °C时，NMR 与量热估计的结晶比例相差最多0.27个百分点。",
      "meaning_cn": "校正 CPMG 幅度后，既可跟踪短 T₂ 分布，也能估计变得难以检出的刚性组分。起点受降温程序、温度采样间隔和检测灵敏度影响；低温比例接近量热结果，并不意味着两种方法对初始结晶的判定完全一致。",
      "publication_date": "2026-11-12",
      "time_scope": "7d_extension",
      "source": "Energy & Fuels",
      "url": "https://doi.org/10.1021/acs.energyfuels.6c05250",
      "doi": "10.1021/acs.energyfuels.6c05250",
      "alternative_sources": [
        {
          "name": "Crossref 题录",
