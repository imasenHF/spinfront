    {
      "item_id": "SF-20261010-07",
      "report_date": "2026-10-10",
      "item_no": 7,
      "title_cn": "非线性T₂–孔径映射校正751块岩心的毛管压力解释",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["td_nmr"],
      "method_ids": ["relaxometry"],
      "application_ids": ["geoscience_flow"],
      "sample_systems": ["751块不同岩性的储层岩心", "NMR T₂、压汞及多孔板毛管压力数据"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Khokholkov等在751块岩心上以分位数对齐建立NMR T₂与压汞或多孔板孔径之间的非线性映射，用r∝T₂ⁿ替代固定线性系数，并将模型参数与岩性和分形维数关联。该方法重建的毛管压力曲线优于传统r=cT₂处理，基于K近邻估计的残余水饱和度与截止值法结果相当。",
      "meaning_cn": "异质岩性下固定表面弛豫率会造成系统偏差，非线性映射更适合分岩性标定。迁移到新储层前应按岩性独立划分训练与验证集，并固定回波间隔、饱和流体、温度和压汞预处理；同时报告曲线误差，不能只比较残余水饱和度。",
      "publication_date": "2026-10-08",
      "time_scope": "7d_extension",
      "source": "Georesources",
      "url": "https://doi.org/10.18599/grs.2026.3.12",
