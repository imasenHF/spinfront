      ],
      "instrument_component_ids": [],
      "sample_systems": [
        "134 kDa IiMDH四聚体",
        "沉降蛋白与溶液蛋白",
        "草氨酸"
      ],
      "information_type": "paper",
      "summary_cn": "Napoli 等结合沉降蛋白的最高四维MAS实验与溶液NMR，研究134 kDa四聚体苹果酸脱氢酶IiMDH，完成92%主链重原子和91%指定甲基归属。¹⁵N R₁ρ及甲基序参量辨认柔性区域；加入草氨酸后的¹H–¹⁵N TROSY位移扰动同时涉及活性位点及α2F、α3G螺旋。",
      "meaning_cn": "同一大型寡聚酶的主链与侧链归属可连接慢运动、疏水核心柔性和配体响应。复用时需确认沉降态与溶液态的折叠及活性一致，并区分位移扰动与直接结合接触；α2F、α3G的响应仅显示与同源酶信号传递区域相关，尚不能直接确定变构路径。",
      "publication_date": "2026-10-13",
      "time_scope": "7d_extension",
      "source": "Journal of the American\nChemical Society",
      "url": "https://pubs.acs.org/doi/10.1021/jacs.6c14423",
