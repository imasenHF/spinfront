        "natural_products"
      ],
      "sample_systems": [
        "除虫菊精油馏分",
        "人工混合物"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Dong 等开发 CORD-NMR，用峰在相关馏分中的共现与强度变化归组，并在单个馏分中用高斯混合模型补充分组。方法再以预测化学位移库检索候选，允许逐原子复核归属。除人工混合物验证外，研究者从除虫菊精油馏分辨认出 17 个已知成分，并据此分离和鉴定 3 个新化合物。",
      "meaning_cn": "当同一组分的谱峰在多个馏分中同步变化时，先分组再检索能缩小待核查范围。共洗脱组分仍可能被归入同组，库外化合物也不会由匹配结果自动定名；宜检查逐原子残差，并以分离或补充谱图确认。",
      "publication_date": "2026-11-25",
      "time_scope": "7d_extension",
      "source": "Journal of Agricultural and Food Chemistry",
      "url": "https://doi.org/10.1021/acs.jafc.6c10486",
      "doi": "10.1021/acs.jafc.6c10486",
      "alternative_sources": [],
      "related_to": [],
      "review_status": "approved",
      "tag_review_status": "approved",
