    {
      "item_id": "SF-20261113-03",
      "report_date": "2026-11-13",
      "item_no": 3,
      "title_cn": "¹H NMR 对照肝细胞胞内与培养液代谢谱",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "metabolomics"
      ],
      "application_ids": [
        "life_science"
      ],
      "instrument_component_ids": [],
      "sample_systems": [
        "原代肝细胞",
        "Hepa1–6",
        "Dt81Hepa1–6"
      ],
      "information_type": "paper",
      "summary_cn": "Goossens 等在24和48小时采集原代肝细胞及两种小鼠肝癌细胞的胞内提取物和培养液，用 ¹H NMR 分析代谢差异。肝癌细胞的乳酸和丙氨酸升高，胞内葡萄糖和谷胱甘肽下降；侵袭性较强的细胞系在培养液中呈现较高的支链氨基酸来源酮酸。",
      "meaning_cn": "配对检测胞内与胞外可区分细胞内代谢物丰度变化和培养液成分随时间的变化。该研究比较的是特定细胞模型；代谢物浓度变化不能直接给出代谢通量，候选特征仍需在其他细胞模型及临床样本中验证。",
      "publication_date": "2026-11-12",
      "time_scope": "7d_extension",
      "source": "PLOS ONE",
      "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0361879",
      "doi": "10.1371/journal.pone.0361879",
