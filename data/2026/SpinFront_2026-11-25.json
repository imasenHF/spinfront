    {
      "item_id": "SF-20261125-02",
      "report_date": "2026-11-25",
      "item_no": 2,
      "title_cn": "³¹P 化学位移预测中，构象多样性更值得投在训练阶段",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "computation_nmr"
      ],
      "application_ids": [
        "chemical_structure"
      ],
      "sample_systems": [
        "Ilm-NMR-P31 数据集",
        "含磷分子构象"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Grenda 等在 Ilm-NMR-P31 数据集上比较构象集合对机器学习 ³¹P 化学位移预测的影响。推断时做构象平均，相对于约 10.5 ppm 的基线仅改善约 0.23 ppm；训练阶段使用多构象的收益约为其四倍。两种收益均在每分子约五个构象时趋于饱和。",
      "meaning_cn": "构象生成资源有限时，可优先覆盖更多不同分子，再增加已有分子的构象数。对已用多构象训练的模型，等权平均在该基准上可匹敌玻尔兹曼加权；部分三价磷亚组统计力有限，不能把五个构象当成所有含磷体系的固定上限。",
      "publication_date": "2026-11-24",
      "time_scope": "7d_extension",
      "source": "Journal of Chemical Information and Modeling",
      "url": "https://doi.org/10.1021/acs.jcim.6c02739",
      "doi": "10.1021/acs.jcim.6c02739",
      "alternative_sources": [],
      "related_to": [],
