    {
      "item_id": "SF-20261008-04",
      "report_date": "2026-10-08",
      "item_no": 4,
      "title_cn": "变温EPR量化Mn²⁺掺杂硼酸盐的晶格畸变",
      "direction_ids": ["epr"],
      "experiment_type_ids": ["cw_epr"],
      "method_ids": ["defect_epr"],
      "application_ids": ["materials"],
      "sample_systems": ["Mn²⁺掺杂YGa₃(BO₃)₄", "Mn²⁺掺杂EuGa₃(BO₃)₄"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Applied Magnetic Resonance联合EPR与X射线衍射研究Mn²⁺掺杂YGa₃(BO₃)₄和EuGa₃(BO₃)₄，温区为4–295 K。结果表明Mn²⁺取代三价稀土位点且保持原位点对称性；随温度升高，S=5/2锰离子基态的零场分裂平滑减小。",
      "meaning_cn": "该结果可用自旋哈密顿量参数的温度依赖反映局域晶格畸变。拟合时应保持晶体取向、微波功率和调制幅度一致，并同时报告g、超精细耦合、零场分裂与线宽；Mn²⁺替位伴随电荷补偿，需结合掺杂浓度和衍射结果排查空位或共缺陷对谱线的贡献。",
      "publication_date": "2026-10-07",
      "time_scope": "24h",
      "source": "Applied Magnetic Resonance",
      "url": "https://link.springer.com/article/10.1007/s00723-026-01886-0",
