    {
      "item_id": "SF-20261013-02",
      "report_date": "2026-10-13",
      "item_no": 2,
      "title_cn": "36套新DP4+参数检验计算NMR结构判别边界",
      "direction_ids": ["nmr"],
      "experiment_type_ids": [],
      "method_ids": ["computation_nmr"],
      "application_ids": ["natural_products"],
      "sample_systems": ["天然产物立体结构", "DP4+化学位移统计参数"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Martorano等基于可定制DP4+方法重新参数化36套协议，覆盖原版未包含的现代DFT泛函、基组和溶剂模型。多数新协议与原版表现接近，其中3套在统计检验中优于原版，扩展了计算NMR用于天然产物候选结构排序时可选的理论层级。",
      "meaning_cn": "DP4+概率依赖与所用量化层级配套的误差分布，直接套用原版16组统计参数可能造成过度置信。实际结构判别需保持构象搜索、溶剂模型、屏蔽计算与参数集一致，并用独立已知结构检查命中率；概率最高仍需与NOE、耦合常数或衍生化结果交叉判断。",
      "publication_date": "2026-10-12",
      "time_scope": "24h",
      "source": "The Journal of Organic Chemistry",
      "url": "https://pubs.acs.org/doi/10.1021/acs.joc.6c01828",
      "doi": "10.1021/acs.joc.6c01828",
