      ],
      "sample_systems": [
        "替尔泊肽tirzepatide",
        "含Aib及脂化侧链的肽"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Nordin 等通过¹H–¹⁵N HMQC、TOCSY、NOESY及1.2 GHz NMR与CD分析替尔泊肽的水溶液构象。Aib²为归属锚点，但不代表稳定末端结构；Aib¹³附近呈局部短螺旋样有序。研究将可靠NOE约束与未分辨信号分开处理，支持局部有序区和柔性区共存的构象集合，而非单一刚性结构。",
      "meaning_cn": "非天然氨基酸与脂化侧链增加归属难度，结构解释应限于可靠的顺序NOE和可分辨残基。高场数据帮助解析局部构象，但不能由游离肽的短螺旋倾向推断受体结合姿态、药效或制剂稳定性；比较不同实验条件时，还需区分局部有序与整体折叠。",
      "publication_date": "2026-10-14",
      "time_scope": "7d_extension",
      "source": "Biomacromolecules",
      "url": "https://pubs.acs.org/doi/10.1021/acs.biomac.6c01139",
      "doi": "10.1021/acs.biomac.6c01139",
      "alternative_sources": [],
      "related_to": [],
      "review_status": "unreviewed",
      "tag_review_status": "approved",
      "publication_status": "early_access",
      "first_seen": "2026-10-19",
      "last_updated": "2026-10-19",
      "report_file": "SpinFront_2026-10-19.html"
    },
