      "item_no": 4,
      "title_cn": "CMD-Net以合成一维训练数据处理低信噪比多维NMR",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "spectral_processing"
      ],
      "application_ids": [],
