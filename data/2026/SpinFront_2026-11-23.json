    {
      "item_id": "SF-20261123-05",
      "report_date": "2026-11-23",
      "item_no": 5,
      "title_cn": "计算流程连接蛋白结构与固体 NMR 信息扰乱动力学",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solid_state_nmr"],
      "method_ids": ["computation_nmr", "dqc"],
      "application_ids": ["structural_biology"],
      "sample_systems": ["10种蛋白质体系", "碳—碳自旋对"],
      "instrument_component_ids": ["software"],
      "information_type": "paper",
      "summary_cn": "White 等建立从分子结构到失序时间相关函数动力学的端到端计算流程，纳入分子动力学、粉末取向平均和自旋网络截断，并以可实验实现的双量子有效哈密顿量分析 10 种蛋白、350 余个碳—碳自旋对。到达时间随核间距离近似线性变化，可在毫秒尺度追踪较长程自旋关联。",
      "meaning_cn": "该工作把量子信息扰乱量与固体 NMR 可执行序列及蛋白距离约束连接起来，为超越局部偶极耦合的结构读出提供计算依据。它仍是预印本中的模拟框架；结构反演的精度、运动模型偏差和真实实验信噪比需要实验数据进一步检验。",
      "publication_date": "2026-11-17",
