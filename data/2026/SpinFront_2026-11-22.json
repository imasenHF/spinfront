      "report_date": "2026-11-22",
      "item_no": 5,
      "title_cn": "原位收集减少贴壁细胞 NMR 代谢组学处理伪影",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solution_nmr"],
      "method_ids": ["metabolomics", "cpmg"],
      "application_ids": ["life_science"],
      "sample_systems": ["AC10人心室心肌细胞"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Ghanameh 等比较胰酶、TrypLE、刮取与原位收集AC10贴壁细胞代谢物的流程；700 MHz ¹H CPMG谱显示，解离流程改变氨基酸与酮体相关代谢信号，而原位收集的谱型更稳定、应激相关变化更少。",
      "meaning_cn": "结果提示细胞解离本身可成为NMR代谢组学的前分析混杂因素。研究采用50%乙腈提取、3 mm管和32—256次扫描，并以原位收集作为优先流程；结论来自单一细胞系，且TSP在复溶时才加入，不能校正提取前回收差异。",
      "publication_date": "2026-11-17",
      "time_scope": "7d_extension",
      "source": "Metabolites",
      "url": "https://doi.org/10.3390/metabo16110903",
      "doi": "10.3390/metabo16110903",
