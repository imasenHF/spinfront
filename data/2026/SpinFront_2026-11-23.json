    {
      "item_id": "SF-20261123-02",
      "report_date": "2026-11-23",
      "item_no": 2,
      "title_cn": "X 波段 EPR 揭示 Mn 掺杂 ludwigite 的短程磁关联",
      "direction_ids": ["epr"],
      "experiment_type_ids": ["cw_epr"],
      "method_ids": [],
      "application_ids": ["materials", "inorganic_coordination"],
      "sample_systems": ["Co₂.₁₉Mn₀.₈₁¹¹BO₅ ludwigite"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Fazlizhanova 等结合中子粉末衍射与 X 波段 EPR 研究 Co₂.₁₉Mn₀.₈₁¹¹BO₅。单一集体共振线的强度在约 170 K 出现宽峰，指向梯链方向的准一维反铁磁关联；110 K 以下又出现以零场为中心的宽共振，显示自旋玻璃冻结前已形成磁关联区域。",
      "meaning_cn": "EPR 与中子散射给出互补的局域动力学和空间关联证据，说明 Mn 位点分布会在长程有序缺失时诱发分阶段短程关联。该结论来自预印本，零场宽共振的归属和温区边界仍需同行评议及更多频率、磁场依赖实验检验。",
      "publication_date": "2026-11-20",
      "time_scope": "7d_extension",
      "source": "Research Square",
      "url": "https://doi.org/10.21203/rs.3.rs-11693408/v1",
