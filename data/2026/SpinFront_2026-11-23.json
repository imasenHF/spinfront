    {
      "item_id": "SF-20261123-10",
      "report_date": "2026-11-23",
      "item_no": 10,
      "title_cn": "⁹³Nb NMR 区分受挫磁体中并存的两类自旋动力学",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solid_state_nmr"],
      "method_ids": ["multinuclear_nmr", "relaxometry"],
      "application_ids": ["materials", "inorganic_coordination"],
      "sample_systems": ["Sr₃CuNb₂O₉受挫磁体"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Biswas 等结合 μSR 与 ⁹³Nb NMR 研究无序受挫磁体 Sr₃CuNb₂O₉。NMR 谱分辨出两种局域磁环境，核磁化恢复的逆拉普拉斯分析进一步得到快、慢两条 T₁ 通道；两者呈不同幂律温度依赖，分别支持随机单态样与量子自旋液体样动力学的微观共存。",
      "meaning_cn": "局域谱线和弛豫分布把平均磁响应拆分为两种动力学组分，为三维无序受挫体系的相共存提供直接微观证据。论文为正式接收稿；“样”相态的归属依赖幂律和模型解释，仍需与更多低温、场依赖及结构无序测量交叉验证。",
      "publication_date": "2026-11-18",
