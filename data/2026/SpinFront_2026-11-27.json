    {
      "item_id": "SF-20261127-03",
      "report_date": "2026-11-27",
      "item_no": 3,
      "title_cn": "原位高压 NMR 区分乙酰丙酮铝的配体响应与配位扰动",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "materials"
      ],
      "sample_systems": [
        "乙酰丙酮铝",
        "压力响应发光固体"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Jin 等用原位高压 NMR 追踪乙酰丙酮铝中的局部变化，发现随着压力升高，响应从配体相关变化扩展到 Al–O 配位环境。光致发光在低于 4 GPa 时可通过强度读出压力；越过该阈值后，光学响应还会保留与既往受压过程有关的信息。",
      "meaning_cn": "光谱能读出压力响应，但原位 NMR 提供了区分“配体先变”和“配位环境进一步受扰”的证据。压力循环对照可帮助区分可逆畸变和卸压后残留的变化；严重畸变产生自由基缺陷是研究提出的机制解释，不能把 NMR 响应直接当成自由基定量。",
      "publication_date": "2026-11-25",
      "time_scope": "7d_extension",
      "source": "Journal of the American Chemical Society",
      "url": "https://doi.org/10.1021/jacs.6c15601",
      "doi": "10.1021/jacs.6c15601",
      "alternative_sources": [],
