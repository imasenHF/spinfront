      "first_seen": "2026-11-26",
      "last_updated": "2026-11-26",
      "report_file": "SpinFront_2026-11-26.html"
    },
    {
      "item_id": "SF-20261126-03",
      "report_date": "2026-11-26",
      "item_no": 3,
      "title_cn": "细胞内 NMR 区分 FUS 低复杂度结构域的成滴与成熟",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "structural_biology"
      ],
      "sample_systems": [
        "FUS 低复杂度结构域",
        "HeLa S3 细胞",
        "可逆淀粉样核心"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Tamura 等用细胞内 NMR 直接追踪 FUS 低复杂度结构域在活细胞内的凝聚，观察到先形成液滴、随后分子活动性下降的两个阶段。缺失突变对照显示，可逆淀粉样核心对后续成熟更关键。营养饥饿抑制成滴，提示细胞的代谢状态参与调节。",
      "meaning_cn": "如果只比较终点时的凝聚比例，容易把初始成滴和后续成熟混为一谈。可结合时间分辨谱信号和缺失突变对照拆分两步。细胞内成滴浓度低于体外阈值，且饥饿涉及多种变化，不能据此把作用归给单一 ATP 依赖过程。",
      "publication_date": "2026-11-25",
      "time_scope": "7d_extension",
      "source": "Nature Communications",
      "url": "https://doi.org/10.1038/s41467-026-79476-8",
      "doi": "10.1038/s41467-026-79476-8",
