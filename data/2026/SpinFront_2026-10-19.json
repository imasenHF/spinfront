    {
      "item_id": "SF-20261019-02",
      "report_date": "2026-10-19",
      "item_no": 2,
      "title_cn": "DMPO-EPR拆分微塑料–水界面的自由基信号",
      "direction_ids": [
        "epr"
      ],
      "experiment_type_ids": [
        "cw_epr"
      ],
      "method_ids": [
        "spin_trapping"
      ],
      "application_ids": [
        "environment"
      ],
      "sample_systems": [
        "聚苯乙烯微塑料",
        "水",
        "DMPO"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Qian 等结合DMPO自旋捕获EPR、谱图模拟及荧光成像，检验聚苯乙烯微塑料在水中的自发自由基生成。EPR主要六线组分归属于DMPO氧化后形成的自由基，同时存在较弱的直接羟基自由基捕获信号；成像与表面活性剂对照进一步支持反应发生在塑料–水界面。",
      "meaning_cn": "原文将200 mg聚苯乙烯与20 mM DMPO水溶液孵育20分钟，滤液在室温、约9.768 GHz下测量，采用20.23 mW功率、1 G调制及12次扫描。主要六线谱不能直接当作经典DMPO–OH四线谱；自由基归属需结合模拟、捕获剂氧化路径及独立对照，而非仅看信号增强。",
      "publication_date": "2026-10-14",
      "time_scope": "7d_extension",
      "source": "Nature",
      "url": "https://www.nature.com/articles/s41586-026-11141-y",
      "doi": "10.1038/s41586-026-11141-y",
      "alternative_sources": [],
      "related_to": [],
      "review_status": "unreviewed",
      "tag_review_status": "approved",
      "publication_status": "published",
      "first_seen": "2026-10-19",
      "last_updated": "2026-10-19",
      "report_file": "SpinFront_2026-10-19.html"
    },
