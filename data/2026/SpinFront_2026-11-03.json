    {
      "item_id": "SF-20261103-04",
      "report_date": "2026-11-03",
      "item_no": 4,
      "title_cn": "水弛豫监测树脂及活性炭捕集Mn²⁺和Cu²⁺",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "td_nmr"
      ],
      "method_ids": [
        "relaxometry"
      ],
      "application_ids": [
        "environment"
      ],
      "sample_systems": [
        "Mn2+",
        "Cu2+",
        "离子交换树脂",
        "活性炭"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Bernardi 等利用上清液水的NMR弛豫跟踪离子交换树脂和活性炭去除Mn²⁺、Cu²⁺的动力学与等温吸附。Cu²⁺去除动力学在各吸附剂间相近，Mn²⁺则以Marathon MSC吸收最快；负载床层水呈多指数弛豫，孔内水弛豫率与金属含量的关联受配位环境影响。",
      "meaning_cn": "弛豫率既反映金属含量，也受离子配位和孔内水可接近性影响。IRC748的螯合作用削弱了金属对水的弛豫效应，因此不能把一种树脂的弛豫率—浓度标定直接转用于另一种材料；上清液动力学与床层孔内水分析也应分别解释。",
      "publication_date": "2026-11-02",
      "time_scope": "7d_extension",
      "source": "International Journal of Environmental Science and Technology",
      "url": "https://link.springer.com/article/10.1007/s13762-026-07529-y",
      "doi": "10.1007/s13762-026-07529-y",
      "alternative_sources": [
        {
          "name": "Crossref作者、日期与题录",
          "url": "https://api.crossref.org/works/10.1007/s13762-026-07529-y"
        }
      ],
      "related_to": [],
      "review_status": "unreviewed",
      "tag_review_status": "approved",
      "publication_status": "published",
      "first_seen": "2026-11-03",
      "last_updated": "2026-11-03",
      "report_file": "SpinFront_2026-11-03.html"
    },
    {
      "item_id": "SF-20261103-05",
      "report_date": "2026-11-03",
      "item_no": 5,
      "title_cn": "低场NMR解析煤体自吸水的多阶段动力学",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "td_nmr"
      ],
      "method_ids": [
        "relaxometry"
      ],
      "application_ids": [
        "geoscience_flow"
      ],
      "sample_systems": [
        "非均质煤体",
        "自吸水"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Xu 等利用低场NMR的T₂谱演化研究煤体自吸水，结合吸附动力学和分阶段渗流模型解释水分迁移。模型区分优势通道流动、活塞式孔隙填充及微孔扩散饱和，对应时间指数约1、0.5和0.2，并由活塞阶段截距反演毛细压力，联系孔连通性与异常吸水系数。",
      "meaning_cn": "T₂谱提供不同弛豫组分的时间变化，而毛细压力来自模型反演，并非NMR直接测压。阶段指数和截距的物理解释依赖孔隙划分及模型假设；将其用于注水速率选择前，需检验润湿性、表面弛豫率与孔连通性，不能把特定煤样的阈值普遍化。",
      "publication_date": "2026-11-01",
      "time_scope": "7d_extension",
      "source": "Langmuir",
      "url": "https://doi.org/10.1021/acs.langmuir.6c05126",
      "doi": "10.1021/acs.langmuir.6c05126",
      "alternative_sources": [
        {
          "name": "Crossref作者、日期与题录",
          "url": "https://api.crossref.org/works/10.1021/acs.langmuir.6c05126"
        }
      ],
      "related_to": [],
      "review_status": "unreviewed",
      "tag_review_status": "approved",
      "publication_status": "unknown",
      "first_seen": "2026-11-03",
      "last_updated": "2026-11-03",
      "report_file": "SpinFront_2026-11-03.html"
    },
    {
      "item_id": "SF-20261103-06",
      "report_date": "2026-11-03",
      "item_no": 6,
      "title_cn": "高频EPR约束四种Mn(III)配合物磁各向异性",
      "direction_ids": [
        "epr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "inorganic_coordination"
      ],
      "sample_systems": [
        "五/六配位Mn(III)单核配合物"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Gao 等比较由席夫碱配体构建的四种单核Mn(III)配合物，其中三种为五配位、一种为六配位。晶体结构显示取代基可改变五配位几何；高频EPR谱分析与模拟给出自旋哈密顿量参数，前三种配合物的负D值支持易轴各向异性，并具有明显的菱形分量。",
      "meaning_cn": "结构与EPR共同约束配位几何和零场分裂，负D及菱形分量应在同一哈密顿量约定下比较。静态磁化率表明高自旋顺磁性，但不能据此宣称存在慢磁弛豫或量子相干；摘要未给具体频率和参数数值，不能补写为可直接复现实验条件。",
      "publication_date": "2026-11-01",
      "time_scope": "7d_extension",
      "source": "ChemistrySelect",
      "url": "https://doi.org/10.1002/slct.75038",
      "doi": "10.1002/slct.75038",
