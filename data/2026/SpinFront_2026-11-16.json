      "report_file": "SpinFront_2026-11-16.html"
    },
    {
      "item_id": "SF-20261116-03",
      "report_date": "2026-11-16",
      "item_no": 3,
      "title_cn": "EPR 与 NMR 共同表征含自由基配体的镧系配合物",
      "direction_ids": [
        "nmr",
        "epr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "paramagnetic_nmr"
      ],
      "application_ids": [
