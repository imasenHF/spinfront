      "item_id": "SF-20261120-01",
      "report_date": "2026-11-20",
      "item_no": 1,
      "title_cn": "NV 色心实现低场纳米尺度氘 NMR",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solid_state_nmr"
      ],
      "method_ids": [
