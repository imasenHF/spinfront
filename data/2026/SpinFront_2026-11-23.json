    {
      "item_id": "SF-20261123-03",
      "report_date": "2026-11-23",
      "item_no": 3,
      "title_cn": "低场二维 NMR 定量孔表面化学对弛豫率的选择性影响",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["td_nmr"],
      "method_ids": ["multidimensional_nmr", "relaxometry"],
      "application_ids": ["materials"],
      "sample_systems": ["介孔二氧化硅", "γ-氧化铝", "受限液体吸附物"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Dong 等用 12.7 MHz 低场二维 ¹H T₁–T₂ 弛豫比较八种液体在介孔二氧化硅和 γ-氧化铝中的固液相互作用。表面脱羟基使丙酮与甲醇官能团的横向表面弛豫率下降约 40%–60%，而环己烷近乎不变，显示弛豫率同时受吸附物化学与孔表面官能化控制。",
      "meaning_cn": "结果提醒多孔材料孔径反演不能把表面弛豫率视为与化学环境无关的常数，也展示低场二维弛豫对表面改性和吸附选择性的敏感性。论文为预印本；不同孔形、场强和表面处理下的参数可迁移性仍需系统验证。",
      "publication_date": "2026-11-17",
      "time_scope": "7d_extension",
      "source": "ChemRxiv",
      "url": "https://doi.org/10.26434/chemrxiv.15012341/v1",
      "doi": "10.26434/chemrxiv.15012341/v1",
