    {
      "item_id": "SF-20261010-10",
      "report_date": "2026-10-10",
      "item_no": 10,
      "title_cn": "无计算机自旋回波板集成T/R开关与可调TE/TR",
      "direction_ids": ["nmr"],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": ["instrumentation"],
      "sample_systems": ["0.5 T台式磁体", "0.1 T全身扫描器"],
      "instrument_component_ids": ["console", "amplifier"],
      "information_type": "paper",
      "summary_cn": "Wilson等设计无需计算机的低成本数字自旋回波发生板，可调激发与重聚脉冲宽度、TE和TR，并集成发射/接收开关、前置放大器及9 V电池供电。作者将其与外部频率合成器、射频功放、示波器和调谐线圈组合，在0.5 T台式磁体与0.1 T全身扫描器上演示自旋回波。",
      "meaning_cn": "该开源硬件适合教学、线圈测试和低场系统快速检修，但矩形脉冲及外部仪器配置不能替代完整谱仪控制台。复现时应核对线圈调谐、功放线性、T/R隔离、B₁校准、磁场稳定性及患者安全边界，并把板卡时序精度与所得信号质量分开评估。",
      "publication_date": "2026-10-06",
      "time_scope": "7d_extension",
      "source": "NMR in Biomedicine",
      "url": "https://onlinelibrary.wiley.com/doi/10.1002/nbm.70419",
      "doi": "10.1002/nbm.70419",
