    {
      "item_id": "SF-20261113-01",
      "report_date": "2026-11-13",
      "item_no": 1,
      "title_cn": "低场多回波饱和恢复测量 ¹²⁹Xe 的长 T₁",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "cpmg",
        "relaxometry"
      ],
      "application_ids": [],
      "instrument_component_ids": [],
      "sample_systems": [
        "热极化¹²⁹Xe",
        "低场NMR"
      ],
      "information_type": "paper",
      "summary_cn": "Sannikov 等在最高1 T的低场条件下，用饱和恢复结合 CPMG 测量三相点附近（161.4 K）的热极化 ¹²⁹Xe。序列在一次扫描内叠加多个回波，提高弱信号的信噪比，避免长 T₁ 样品因反复等待恢复而延长总实验时间。",
      "meaning_cn": "可把原本用于多次扫描的时间转为单次扫描内的回波采样。适用前提是 T₂ 足够长，且场不均匀造成的 T₂* 明显短于 T₂；如果回波串衰减太快，增加回波数也会纳入更多噪声。摘要未给出可通用于其他样品的增益倍数。",
      "publication_date": "2026-11-12",
      "time_scope": "7d_extension",
      "source": "Applied Magnetic Resonance",
      "url": "https://link.springer.com/article/10.1007/s00723-026-01896-y",
      "doi": "10.1007/s00723-026-01896-y",
      "alternative_sources": [],
      "related_to": [],
