    {
      "item_id": "SF-20261010-08",
      "report_date": "2026-10-10",
      "item_no": 8,
      "title_cn": "7 T ¹³C MRS无创测量McArdle病肌糖原",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["in_vivo_mrs"],
      "method_ids": [],
      "application_ids": ["life_science"],
      "sample_systems": ["14名McArdle病患者", "19名健康对照的腰部、大腿和小腿肌肉"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Stemmerik等用7 T ¹³C MRS无创比较14名McArdle病患者与19名健康对照的腰部、大腿和小腿肌糖原。患者小腿、腘绳肌与大腿前侧、腰部的糖原分别约为对照的3.2、2.7和2.1倍；患者不同肌群间分布较均匀，因此局部糖原水平未显示出预测肌肉损伤部位的能力。",
      "meaning_cn": "高场¹³C MRS可在不活检的情况下做跨肌群代谢比较，但样本量和横断面设计限制了预后判断。后续研究需统一线圈灵敏度、体素定位、自然丰度¹³C信噪比和绝对定量参照，并用纵向运动负荷及损伤指标检验预测价值。",
      "publication_date": "2026-10-07",
      "time_scope": "7d_extension",
      "source": "Muscle & Nerve",
      "url": "https://onlinelibrary.wiley.com/doi/10.1002/mus.70433",
      "doi": "10.1002/mus.70433",
