    {
      "item_id": "SF-20261110-03",
      "report_date": "2026-11-10",
      "item_no": 3,
      "title_cn": "EPR 与猝灭对照解析 UV／过乙酸处理中的硝化副反应",
      "direction_ids": [
        "epr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "environment"
      ],
      "instrument_component_ids": [],
      "sample_systems": [
        "紫外／过乙酸",
        "亚硝酸盐",
        "苯酚",
        "天然有机质"
      ],
      "information_type": "paper",
      "summary_cn": "Chu 等结合 EPR 和自由基猝灭实验，研究紫外光活化过乙酸处理含亚硝酸盐的水。结果支持有机自由基与羟基自由基主导苯酚降解；亚硝酸盐可消耗部分羟基自由基并生成二氧化氮自由基。结合反应对照，研究将乙酰过氧自由基与促进酚氧自由基参与的硝化路径联系起来。",
      "meaning_cn": "在 100 μM 亚硝酸盐、5 mg C/L 天然有机质和 0.5 mM 过乙酸的实验体系中，照射 6 小时后硝化产物为 3.955 μM。评估此类处理工艺时，EPR 与猝灭对照可帮助定位潜在副反应，实际副产物浓度仍需化学定量；单凭自由基信号不能推算不同进水的产率。",
      "publication_date": "2026-11-07",
      "time_scope": "7d_extension",
      "source": "Journal of Hazardous Materials",
      "url": "https://doi.org/10.1016/j.jhazmat.2026.144116",
      "doi": "10.1016/j.jhazmat.2026.144116",
      "alternative_sources": [
        {
