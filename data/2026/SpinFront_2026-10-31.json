      "report_date": "2026-10-31",
      "item_no": 10,
      "title_cn": "采购与需求动态：长春应化所EPR高温及时间分辨系统中标",
      "direction_ids": [
        "epr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "instrumentation"
      ],
      "sample_systems": [
        "EPR-TRHT高温及时间分辨系统1套"
      ],
      "instrument_component_ids": [],
