      "item_id": "SF-20261103-01",
      "report_date": "2026-11-03",
      "item_no": 1,
      "title_cn": "细胞类型与恢复时间改变胞内脉冲偶极EPR数据",
      "direction_ids": [
        "epr"
      ],
