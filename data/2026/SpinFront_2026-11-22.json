    {
      "item_id": "SF-20261122-04",
      "report_date": "2026-11-22",
      "item_no": 4,
      "title_cn": "离子液体原位转化结合 ¹H NMR 定量微生物 PHB",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solution_nmr"],
      "method_ids": ["qnmr", "reaction_monitoring"],
      "application_ids": ["polymers", "process_analysis"],
      "sample_systems": [],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Miranda 等用[EMIM][OAc]同时从微生物生物质中提取并解聚聚(3-羟基丁酸)，再以¹H NMR定量生成的巴豆酸。100 °C长时处理转化不完全，140 °C、60 min可完全转化；NMR结果与常规气相色谱总体一致。",
      "meaning_cn": "无酸一锅处理把样品预处理、反应监控和定量连接起来，可用于PHB积累筛选。低PHB含量时偏差和重复性变差，且140 °C处理条件、离子液体基质与巴豆酸峰的定量关系需要在不同菌体组成和批次中保持一致。",
      "publication_date": "2026-11-18",
      "time_scope": "7d_extension",
      "source": "ACS Sustainable Chemistry & Engineering",
      "url": "https://doi.org/10.1021/acssuschemeng.6c09884",
