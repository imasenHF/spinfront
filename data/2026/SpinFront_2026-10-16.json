    {
      "item_id": "SF-20261016-03",
      "report_date": "2026-10-16",
      "item_no": 3,
      "title_cn": "硅中磷核自旋的电偶极驱动共振理论结合超精细与磁场梯度",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "quantum_spin"
      ],
      "sample_systems": [
        "硅中磷核自旋量子位",
        "超精细耦合",
        "磁场梯度",
        "EDNER"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Su 等提出硅中磷核自旋的电偶极诱导核电共振（EDNER）理论方案。超精细相互作用连接核自旋与电子自旋，磁场梯度再连接电子的自旋和电荷自由度，使电场能够驱动核自旋跃迁。模型还给出核自旋能级劈裂对电噪声较不敏感的工作点；该结果为理论预印本，尚无本文实验验证。",
      "meaning_cn": "该方案把核自旋操控与局域电场、超精细耦合及磁场梯度联系起来，研究对象为硅中自旋量子位。应用前需检验驱动速率与电噪声敏感性的共同变化，并用实验核对工作点和相干时间。摘要未给出可直接用于常规液体或固体NMR谱仪的脉冲参数。",
      "publication_date": "2026-10-09",
      "time_scope": "7d_extension",
      "source": "arXiv（理论预印本）",
      "url": "https://arxiv.org/abs/2610.14139",
      "doi": "10.48550/arxiv.2610.14139",
