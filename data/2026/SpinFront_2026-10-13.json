    {
      "item_id": "SF-20261013-05",
      "report_date": "2026-10-13",
      "item_no": 5,
      "title_cn": "NMR与中子散射解析钡氧氟硼酸盐玻璃网络重排",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["solid_state_nmr"],
      "method_ids": ["computation_nmr"],
      "application_ids": ["materials", "chemical_structure"],
      "sample_systems": ["NaFₓ(BaO·2B₂O₃)玻璃", "x=0–35 mol%"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Robledo等联合NMR、总中子散射和分子动力学研究NaFₓ(BaO·2B₂O₃)玻璃，NaF比例覆盖0–35 mol%。结果显示四配位硼比例N₄随组成改变而增加，该趋势可由BO₃F与BO₂F局域结构比例变化解释，将平均散射信息与局域配位环境对应起来。",
      "meaning_cn": "玻璃缺少长程有序，单一衍射结果难以区分相近的硼—氟局域单元；NMR与总散射、分子动力学联合可约束配位数和网络模型。配方比较需固定含氟量、热史和谱图拟合方式，并报告模拟组成与实验组成的一致性，避免只凭N₄变化确定唯一结构。",
      "publication_date": "2026-10-12",
      "time_scope": "24h",
      "source": "The Journal of Physical Chemistry B",
      "url": "https://pubs.acs.org/doi/10.1021/acs.jpcb.6c03122",
