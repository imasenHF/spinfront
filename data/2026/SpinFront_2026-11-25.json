    {
      "item_id": "SF-20261125-04",
      "report_date": "2026-11-25",
      "item_no": 4,
      "title_cn": "交换 NMR 解析 MDM2 与抑制性类肽的耦合构象平衡",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [
        "solution_nmr"
      ],
      "method_ids": [],
      "application_ids": [
        "structural_biology"
      ],
      "sample_systems": [
        "MDM2",
        "抑制性类肽",
        "酰胺键异构体"
      ],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Ueda 等用 ZZ 交换 NMR 表明，含顺式酰胺键的类肽异构体与 MDM2 的结合弱于全反式异构体。MDM2 的 Ile19 甲基共振还分辨出开放与半闭合态；半闭合态占比升高与亲和力下降相关，支持配体和蛋白的构象平衡共同影响结合。",
      "meaning_cn": "去除限制主链的甲基后，亲和力下降超过百倍，但修饰前后全反式配体比例之比仅为 1.6。该差异说明仅测游离配体的构象比例不足以解释结合结果；还可用蛋白报告峰追踪受体态分布，但相关性不足以独立量化两项贡献。",
      "publication_date": "2026-11-24",
      "time_scope": "7d_extension",
      "source": "Journal of the American Chemical Society",
      "url": "https://doi.org/10.1021/jacs.6c14309",
      "doi": "10.1021/jacs.6c14309",
      "alternative_sources": [],
      "related_to": [],
