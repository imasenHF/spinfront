    {
      "item_id": "SF-20261112-02",
      "report_date": "2026-11-12",
      "item_no": 2,
      "title_cn": "三轴注入实验区分 ¹²⁹Xe NMR 角速度传感器的磁噪声贡献",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "instrumentation"
      ],
      "instrument_component_ids": [],
      "sample_systems": [
        "Rb–¹²⁹Xe NMR 角速度传感器"
      ],
      "information_type": "paper",
      "summary_cn": "Wang 等用 Bloch 动力学与脉冲灵敏度函数建立磁噪声到核自旋频率稳定性的模型，并向 Rb–¹²⁹Xe 传感器三轴线圈注入噪声。纵向白噪声增加白频噪声贡献，纵向闪烁噪声抬高拟合的稳定性平台；模型还描述残余横向直流场放大低频噪声的条件。",
      "meaning_cn": "以重叠 Allan 偏差比较不同方向和噪声类型，有助于区分轴向噪声与横向偏置的贡献。这个模型针对核自旋共振频率，横向噪声结果也有特定适用条件；它不包含完整的角速度误差预算，不能直接把频率稳定度换算为整机精度。",
      "publication_date": "2026-11-10",
      "time_scope": "7d_extension",
      "source": "Micromachines",
      "url": "https://www.mdpi.com/2072-666X/17/11/1307",
      "doi": "10.3390/mi17111307",
      "alternative_sources": [],
      "related_to": [],
      "review_status": "unreviewed",
      "tag_review_status": "approved",
      "publication_status": "published",
      "first_seen": "2026-11-12",
      "last_updated": "2026-11-12",
      "report_file": "SpinFront_2026-11-12.html"
    },
    {
      "item_id": "SF-20261112-03",
      "report_date": "2026-11-12",
      "item_no": 3,
      "title_cn": "¹H 位移比较推拉烯烃的供受体效应",
      "direction_ids": [
        "nmr"
      ],
      "experiment_type_ids": [],
      "method_ids": [],
      "application_ids": [
        "chemical_structure"
      ],
      "instrument_component_ids": [],
      "sample_systems": [
        "非对称推拉烯烃",
        "DASA 前体"
      ],
      "information_type": "paper",
      "summary_cn": "Fu 等比较多类非对称推拉烯烃中暂定归属的烯键氢，实测 ¹H 化学位移跨7.93–8.68 ppm。呋喃供体系列中，位移与受体吸电子强度呈经验正相关；噻吩类似物出现异常低场偏移，作者结合共振给电子、诱导效应和位阻解释。",
      "meaning_cn": "同系列化合物的位移变化可以检验取代基与局部电子环境的关联，但磁各向异性、共轭和位阻也会改变屏蔽。呋喃系列的经验关系尚不能推广到所有供体；烯键氢归属仍为暂定，比较前需先确认对应的是同类信号。",
      "publication_date": "2026-11-10",
      "time_scope": "7d_extension",
      "source": "ChemistrySelect",
      "url": "https://doi.org/10.1002/slct.75116",
      "doi": "10.1002/slct.75116",
