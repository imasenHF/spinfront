    {
      "item_id": "SF-20261116-01",
      "report_date": "2026-11-16",
      "item_no": 1,
      "title_cn": "活体斑马鱼胚胎 EPR 检测照射后的自由基信号",
      "direction_ids": [
        "epr"
      ],
      "experiment_type_ids": [],
      "method_ids": [
        "spin_probe"
      ],
      "application_ids": [
        "life_science"
      ],
      "instrument_component_ids": [],
      "sample_systems": [
        "斑马鱼胚胎",
        "E3培养液"
      ],
      "information_type": "paper",
      "summary_cn": "Pehlivan 等用氮氧自由基探针，在两种供氧条件下比较常规与超高剂量率电子束照射。EPR 能在活胚胎中可靠检出信号；探索性比较未见两剂量率之间的信号差异达到统计显著。流程本身未显示出对所测存活、生长或结构指标的显著影响。",
      "meaning_cn": "培养液中的剂量率和氧依赖变化不能直接外推到活胚胎。比较两种剂量率时，需同时核对供氧、探针响应与观察窗口；可检出自由基信号证明了测量可行性，未达到显著也不能视为两种照射条件等效。",
      "publication_date": "2026-11-13",
      "time_scope": "7d_extension",
      "source": "Physics in Medicine & Biology",
      "url": "https://doi.org/10.1088/1361-6560/aec216",
      "doi": "10.1088/1361-6560/aec216",
      "alternative_sources": [
        {
          "name": "PubMed 题录与摘要",
          "url": "https://pubmed.ncbi.nlm.nih.gov/43024954/"
        }
      ],
