    {
      "item_id": "SF-20261111-04",
      "report_date": "2026-11-11",
      "item_no": 4,
      "title_cn": "多核 NMR 定位 YdbL 与 YnbE 肽段的结合界面",
      "direction_ids": [
        "nmr"
