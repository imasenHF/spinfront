      "title_cn": "脉冲偶极EPR将TRIM25距离测量延伸至17.3 nm",
      "direction_ids": ["epr"],
      "experiment_type_ids": ["pulsed_epr"],
      "method_ids": ["pds"],
      "application_ids": ["structural_biology"],
      "sample_systems": ["TRIM25卷曲螺旋蛋白", "全氘代蛋白"],
