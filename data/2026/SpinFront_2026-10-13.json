      "item_no": 6,
      "title_cn": "3 T单体素¹H-MRS检出ALS小脑谷胱甘肽下降",
      "direction_ids": ["nmr"],
      "experiment_type_ids": ["in_vivo_mrs"],
      "method_ids": [],
      "application_ids": ["life_science"],
      "sample_systems": ["30例散发性ALS", "22例健康对照", "16例SPG4", "左侧小脑半球"],
      "instrument_component_ids": [],
      "information_type": "paper",
      "summary_cn": "Vornetti等在3 T条件下对30例散发性ALS、22例健康对照和16例SPG4进行左侧小脑单体素¹H-MRS及体积分析。ALS组肌醇/肌酸和谷胱甘肽/肌酸均下降；其中谷胱甘肽/肌酸区分ALS与健康对照、SPG4的AUC分别为0.80和0.71。",
      "meaning_cn": "小脑¹H-MRS把代谢变化与局部体积萎缩放在同一受试者内比较，谷胱甘肽比值可作为候选辅助指标。现有样本量较小且采用单侧单体素和肌酸归一化；复核时需控制体素分割、部分容积、线宽与水抑制，并以绝对定量和纵向数据检查稳定性。",
      "publication_date": "2026-10-12",
